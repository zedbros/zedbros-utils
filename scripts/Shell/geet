#!/bin/sh
# This script speeds up my github commands add --all, status, commit -m "commit message" and push; with one command.
# Allows empty messages and empty commits.
# Added convential commit generator.

white="\e[0m"
green="\e[1;32m"
yellow="\e[1;33m"
purple="\e[1;35m"
cyan="\e[1;36m"

red="\e[1;91m"
flashing="\e[1;3;5;96m"

generate-conventional-commit () {
	types=(
		feat
		fix
		refactor
		docs
		test
		revert
		update
		[checkpoint]
		[QOF]
	)

	ask() {
		read -r -p "$1" -e result && echo "$result"
	}
	selectType() {
		echo -e "\n${cyan}Select commit type:${white}"

		local i=1
		for type in "${types[@]}"; do
			echo -e "  ${purple}$i)${white} $type"
			((i++))
		done

		local choice
		while true; do
			printf "\n" && read -n1 -r -p "Choice [1-${#types[@]}]: " choice
			if [[ "$choice" =~ ^[0-9]+$ ]] &&
			   (( choice >= 1 && choice <= ${#types[@]} )); then
				selectedType="${types[$((choice-1))]}"
				break
			fi
			echo -e "${red}Invalid choice.${white}"
		done
	}

	printf "\n${purple}===== Conventional Commit Generator =====${white}\n"

	selectType

	scope=$(ask $'\nScope (optional): ')
	description=$(ask $'Commit description: ')

	while [[ -z "$description" ]]; do
		echo -e "${red}Commit description cannot be empty.${white}"
		description=$(ask "Commit description: ")
	done

	read -n1 -r -p $'\nIs this a breaking change? [yN]: ' breaking
	read -n1 -r -p $'\nAdd an extended description? [yN]: ' extended && printf "\n"
	body=""

	if [[ "$extended" =~ ^[yY]$ ]]; then
		echo "Enter description (finish with an empty line):"

		while IFS= read -er line; do
			[[ -z "$line" ]] && break
			if [[ -n "$body" ]]; then
				body+=$'\n'
			fi
			body+="$line"
		done
	fi

	read -n1 -r -p $'Add a footer? [yN]: ' addFooter
	footer=""

	if [[ "$addFooter" =~ ^[yY]$ ]]; then
		footer=$(ask "Footer (e.g. Closes #42): ")
	fi

	commitType="$selectedType"

	if [[ "$breaking" =~ ^[yY]$ ]]; then
		commitType+="!"
	fi
	if [[ -n "$scope" ]]; then
		commitType="${selectedType}(${scope})"
		[[ "$breaking" =~ ^[yY]$ ]] && commitType+="!"
	fi

	commitMessage="${commitType}: ${description}"

	if [[ -n "$body" ]]; then
		commitMessage+=$'\n\n'"$body"
	fi
	if [[ "$breaking" =~ ^[yY]$ ]]; then
		commitMessage+=$'\n\n'"BREAKING CHANGE: ${description}"
	fi
	if [[ -n "$footer" ]]; then
		commitMessage+=$'\n\n'"$footer"
	fi

	echo -e "\n\n${cyan}===== Commit Preview =====${white}"
	printf '%s\n' "$commitMessage"
	echo -e "${cyan}==========================${white}"

	read -n1 -r -p $'\nCreate this commit? [yN]: ' confirm && printf "\n"
	if [[ "$confirm" =~ ^[yY]$ ]]; then
		git commit -m "$commitMessage"
		echo -e "${green}Commit created successfully!${white}\n"
		printf "${flashing}Push ? ${white}" && read -p "(y/N): " pushyesno && printf "\n"
		if [[ "$pushyesno" =~ ^[yY]$ ]]; then git push; else printf "${red}Push cancelled.${white}\n"; exit; fi
	else
		echo -e "${red}Commit cancelled.${white}"
		exit
	fi
}

git add .
git status

read -n1 -p "Do you wish to commit? [Yn]: " answer && printf "\n"

if [[ -z "$answer" || "$answer" =~ [yY] ]]; then
	read -n1 -p "Conventional commit ? [Yn]: " convcommyesno && printf "\n"

	if [[ -z "$convcommyesno" || "$convcommyesno" =~ [yY] ]]; then
		generate-conventional-commit
	else
		read -p $'\ngit commit -m ' -e mes
		git commit --allow-empty --allow-empty-message -m "$mes"
		echo -e "${green}Commit created successfully!${white}\n"
		printf "${flashing}Push ? ${white}" && read -p "(y/N): " pushyesno && printf "\n"
		if [[ "$pushyesno" =~ ^[yY]$ ]]; then git push; else printf "${red}Push cancelled.${white}\n"; exit; fi
	fi
	printf "\n${purple}--- WAZAAA ---${white}\n"
else
    printf "\n${red}Commit cancelled.${white}\n"
	exit
fi

